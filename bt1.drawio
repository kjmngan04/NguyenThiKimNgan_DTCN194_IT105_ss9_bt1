        <mxCell id="LvrpYcQB_yon7L6U5gvG-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;strong&gt;Lỗi 1: &lt;code&gt;Kiểm tra hạn lưu kho&lt;/code&gt; gửi sang &lt;code&gt;ExpiryChecker&lt;/code&gt; là sai.&lt;/strong&gt;&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;br&gt;&lt;ul&gt;&lt;br&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;Trong đề bài, &lt;code&gt;InventoryManager&lt;/code&gt; &lt;strong&gt;tự kiểm tra hạn lưu kho trên chính nó&lt;/strong&gt;.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;Vì vậy đây phải là &lt;strong&gt;Self Message&lt;/strong&gt;.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;Không được gửi thông điệp từ &lt;code&gt;InventoryManager&lt;/code&gt; sang &lt;code&gt;ExpiryChecker&lt;/code&gt;.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;Thực tế sơ đồ giả đã tạo thêm đối tượng &lt;code&gt;ExpiryChecker&lt;/code&gt;, nhưng đối tượng này &lt;strong&gt;không thuộc luồng nghiệp vụ được yêu cầu&lt;/strong&gt;.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot;&gt;&lt;font size=&quot;3&quot;&gt;→ Sửa thành:&lt;/font&gt;&lt;/p&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot;&gt;&lt;code&gt;&lt;font size=&quot;3&quot;&gt;InventoryManager → InventoryManager : Kiểm tra hạn lưu kho() [Self]&lt;/font&gt;&lt;/code&gt;&lt;/p&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;&lt;font size=&quot;3&quot;&gt;Lỗi 2: &lt;code&gt;Kết quả xuất kho&lt;/code&gt; đang dùng kiểu thông điệp không đúng.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;ul&gt;&lt;br&gt;&lt;li&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;code&gt;WarehouseUI&lt;/code&gt; gửi &lt;code&gt;export_package()&lt;/code&gt; và &lt;strong&gt;chờ kết quả&lt;/strong&gt; → đây là &lt;strong&gt;Sync&lt;/strong&gt;.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;Sau khi &lt;code&gt;InventoryManager&lt;/code&gt; xử lý xong, kết quả quay về &lt;code&gt;WarehouseUI&lt;/code&gt; phải là &lt;strong&gt;Return&lt;/strong&gt;.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;Return nên được biểu diễn bằng &lt;strong&gt;đường nét đứt + mũi tên mở&lt;/strong&gt;, không dùng lại Sync.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot;&gt;&lt;font size=&quot;3&quot;&gt;→ Sửa thành:&lt;/font&gt;&lt;/p&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot;&gt;&lt;code&gt;&lt;font size=&quot;3&quot;&gt;InventoryManager -- -- &amp;gt; WarehouseUI : Kết quả xuất kho [Return]&lt;/font&gt;&lt;/code&gt;&lt;/p&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="280" y="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
